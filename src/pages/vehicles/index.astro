---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = { title: 'Vehicles' };

const vehicles = await getCollection('vehicles');
const active = vehicles.filter((v) => v.data.status === 'active');
const retired = vehicles.filter((v) => v.data.status === 'retired');
---

<Layout metadata={metadata}>
  <WidgetWrapper>
    <Headline title="Vehicles" subtitle="Aircraft the team has designed, built, and flown." />

    {vehicles.length === 0 && <p class="text-muted">No vehicles listed yet.</p>}

    {
      active.length > 0 && (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-12">
          {active.map((vehicle) => (
            <a
              href={getPermalink(`/vehicles/${vehicle.id}`)}
              class="block rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden hover:shadow-lg transition"
            >
              {vehicle.data.heroImage && (
                <Image
                  src={vehicle.data.heroImage}
                  alt={`TODO: alt — ${vehicle.data.name}`}
                  width={600}
                  height={400}
                  class="w-full h-48 object-cover"
                />
              )}
              <div class="p-4">
                <h3 class="text-xl font-bold">{vehicle.data.name}</h3>
                <p class="text-muted text-sm">{vehicle.data.year}</p>
              </div>
            </a>
          ))}
        </div>
      )
    }

    {
      retired.length > 0 && (
        <>
          <h2 class="text-2xl font-bold mb-4">Retired vehicles (archive)</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {retired.map((vehicle) => (
              <a
                href={getPermalink(`/vehicles/${vehicle.id}`)}
                class="block rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden opacity-80 hover:opacity-100 hover:shadow-lg transition"
              >
                {vehicle.data.heroImage && (
                  <Image
                    src={vehicle.data.heroImage}
                    alt={`TODO: alt — ${vehicle.data.name}`}
                    width={600}
                    height={400}
                    class="w-full h-48 object-cover"
                  />
                )}
                <div class="p-4">
                  <h3 class="text-xl font-bold">{vehicle.data.name}</h3>
                  <p class="text-muted text-sm">{vehicle.data.year} · Retired</p>
                </div>
              </a>
            ))}
          </div>
        </>
      )
    }
  </WidgetWrapper>
</Layout>

---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'UMBC SUAS',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      { variant: 'primary', text: 'View vehicles', href: getPermalink('/vehicles') },
      { text: 'Contact us', href: getPermalink('/contact') },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'TODO: alt — replace with a real team/vehicle photo' }}
  >
    <Fragment slot="title">UMBC Small Unmanned Aircraft Systems</Fragment>

    <Fragment slot="subtitle">
      UMBC's competition team for the AUVSI SUAS competition, designing, building, and flying autonomous aircraft. TODO:
      expand with a fuller mission statement.
    </Fragment>
  </Hero>

  <!-- Features2 Widget: section classifier cards ************** -->

  <Features2
    title="Explore the site"
    items={[
      {
        title: 'Vehicles',
        description: 'Aircraft the team has designed, built, and flown — specs, photos, and design decisions.',
        icon: 'tabler:plane',
        callToAction: { text: 'Browse vehicles', href: getPermalink('/vehicles') },
      },
      {
        title: 'Documentation',
        description: "Full technical documentation for each vehicle, once it's ready.",
        icon: 'tabler:book-2',
        callToAction: { text: 'View documentation', href: getPermalink('/docs') },
      },
      {
        title: 'Build Log',
        description: "A chronological record of the team's progress, tagged by subsystem.",
        icon: 'tabler:timeline',
        callToAction: { text: 'Read the log', href: getBlogPermalink() },
      },
      {
        title: 'Team',
        description: 'The students behind UMBC SUAS.',
        icon: 'tabler:users',
        callToAction: { text: 'Meet the team', href: getPermalink('/team') },
      },
      {
        title: 'Sponsors',
        description: 'The organizations that make this program possible.',
        icon: 'tabler:heart-handshake',
        callToAction: { text: 'See sponsors', href: getPermalink('/sponsors') },
      },
    ]}
  />

  <!-- Latest build log entries ******* -->

  <BlogLatestPosts
    title="Latest from the Build Log"
    linkText="View full log"
    information="Recent updates from across the team, tagged by subsystem."
  />
</Layout>

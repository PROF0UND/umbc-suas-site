---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

const metadata = { title: 'Sponsors' };

const sponsors = await getCollection('sponsors');
const tiers = [...new Set(sponsors.map((s) => s.data.tier))];
---

<Layout metadata={metadata}>
  <WidgetWrapper>
    <Headline title="Sponsors" subtitle="UMBC SUAS is grateful for the support of our sponsors." />

    {sponsors.length === 0 && <p class="text-muted">No sponsors listed yet.</p>}

    {
      tiers.map((tier) => (
        <div class="mb-10">
          <h2 class="text-xl font-bold mb-4">{tier}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-8 items-center">
            {sponsors
              .filter((s) => s.data.tier === tier)
              .map((sponsor) =>
                sponsor.data.url ? (
                  <a href={sponsor.data.url} target="_blank" rel="noopener noreferrer" class="block">
                    <Image
                      src={sponsor.data.logo}
                      alt={`TODO: alt — ${sponsor.data.name} logo`}
                      width={240}
                      height={120}
                      class="mx-auto max-h-20 w-auto object-contain"
                    />
                  </a>
                ) : (
                  <Image
                    src={sponsor.data.logo}
                    alt={`TODO: alt — ${sponsor.data.name} logo`}
                    width={240}
                    height={120}
                    class="mx-auto max-h-20 w-auto object-contain"
                  />
                )
              )}
          </div>
        </div>
      ))
    }
  </WidgetWrapper>
</Layout>
